{
  "name": "cografya-oyunu",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/panoramas/check-local-gallery.mjs --strict > /dev/null && node scripts/panoramas/check-eraatlas-outdoors.mjs > /dev/null && node scripts/check-vercel-vs-env.mjs && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "native:android": "npm run build && npx cap add android",
    "native:ios": "npm run build && npx cap add ios && npm run native:configure && npx cap sync ios",
    "native:sync": "npm run build && npx cap sync",
    "native:configure": "node scripts/configure-admob-native.mjs && node scripts/configure-push-ios.mjs",
    "native:release:check": "node scripts/validate-admob-release.mjs",
    "native:ios:sync": "npm run build && npx cap sync ios && npm run native:configure",
    "gallery:audit": "node scripts/panoramas/check-local-gallery.mjs",
    "outdoor:audit": "node scripts/panoramas/check-eraatlas-outdoors.mjs",
    "gallery:release-check": "node scripts/panoramas/check-local-gallery.mjs --release",
    "gallery:discover": "node scripts/panoramas/discover-commons.mjs",
    "gallery:photo-review": "node scripts/panoramas/export-appstore-review.mjs",
    "gallery:commons-audit": "node scripts/panoramas/verify-commons-licenses.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "d3-geo": "^3.1.1",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/android": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor-community/admob": "8.2.0",
    "motion": "^12.23.0",
    "canvas-confetti": "^1.9.3",
    "@react-three/fiber": "8.18.0",
    "@tsparticles/engine": "4.4.0",
    "@tsparticles/react": "4.4.0",
    "@tsparticles/slim": "4.4.0",
    "lottie-react": "2.4.2",
    "howler": "2.2.4",
    "three": "0.170.0",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/app": "8.1.0",
    "pannellum": "2.5.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "@capacitor/cli": "8.5.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/howler": "2.2.12",
    "@types/three": "0.170.0"
  }
}
