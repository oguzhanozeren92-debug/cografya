# Tarayıcıya dağıtılır: Supabase'in yalnızca publishable/anon anahtarını kullan.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Bu birimler Coğrafya uygulamasına ait rewarded AdMob reklam birimleri olmalı.
# Uygulama (App) ID'si DEĞİL; ca-app-pub-.../... biçiminde.
VITE_ADMOB_REWARDED_IOS_ID=
VITE_ADMOB_REWARDED_ANDROID_ID=

# SADECE cihazda test derlemeleri için aç; mağaza sürümünde kesinlikle false.
VITE_ADMOB_USE_TEST_ADS=false
# Sokak Dedektifi server-side on Vercel (secret stays on server, not VITE_):
# STREET_R2_PUBLIC_BASE_URL=https://your-public-r2-custom-domain
# STREET_SESSION_SECRET=use-random-strong-value-at-least-32-characters


# Optional native ad placements. Leave blank to disable that format.
# Native TEST builds can use VITE_ADMOB_USE_TEST_ADS=true instead.
VITE_ADMOB_BANNER_IOS_ID=
VITE_ADMOB_BANNER_ANDROID_ID=
VITE_ADMOB_INTERSTITIAL_IOS_ID=
VITE_ADMOB_INTERSTITIAL_ANDROID_ID=
